# Maintainer: Edward Pratt
#
# Burrow from its main branch. `makepkg -si` in this folder builds the
# window, the daemon, the command line and the server agent, and pulls in
# what they need. Build it from a checkout with
# `source=("git+file://$PWD/../..")` to package local changes.

pkgname=burrow-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="A desktop home base for servers and databases: terminals, SSH, PostgreSQL and tunnels in one window"
arch=(x86_64)
url="https://github.com/Edward-Pratt/burrow"
license=(GPL-3.0-or-later)
# gtk4 4.20 or newer: the window follows gtk-interface-color-scheme.
depends=(gtk4 vte4 gtksourceview5 openssh)
# burrow-agent, which Burrow uploads to servers, is built for each musl
# target whose standard library is installed: rust-musl and
# rust-aarch64-musl, or `rustup target add <target>`. Only those are
# packaged, and `burrow doctor` says which are missing.
makedepends=(git cargo)
optdepends=(
  'gnome-keyring: a Secret Service, which Burrow keeps passwords in (or KWallet, or KeePassXC)'
)
provides=(burrow)
conflicts=(burrow)
# ring's C parts don't link with makepkg's -flto.
options=(!lto)
source=("git+$url.git")
sha256sums=(SKIP)

pkgver() {
  cd burrow
  printf '%s.r%s.g%s' \
    "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd burrow
  cargo fetch --locked
}

build() {
  cd burrow
  export CARGO_TARGET_DIR=target
  # Names the commit, so a daemon left running from before an upgrade
  # looks out of date to the new window.
  export BURROW_BUILD=$pkgver
  cargo build --frozen --release -p burrow-gtk -p burrowd -p burrow-cli
  for target in x86_64-unknown-linux-musl aarch64-unknown-linux-musl; do
    [ -d "$(rustc --print target-libdir --target "$target")" ] || continue
    cargo build --frozen --profile agent -p burrow-agent --target "$target"
  done
}

# No check(): the tests start sshd and a PostgreSQL server of their own,
# which a build machine may not have. CI runs them on every change.

package() {
  cd burrow
  install -Dm755 target/release/burrow-gtk target/release/burrowd target/release/burrow \
    -t "$pkgdir/usr/bin"
  # Where the core looks for agent builds (ssh/agent.rs, INSTALLED).
  for arch in x86_64 aarch64; do
    agent="target/$arch-unknown-linux-musl/agent/burrow-agent"
    if [ -f "$agent" ]; then
      install -Dm755 "$agent" "$pkgdir/usr/lib/burrow/burrow-agent-$arch"
    fi
  done
  install -Dm644 dist/systemd/burrowd.service dist/systemd/burrowd.socket \
    -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 dist/dev.burrow.Burrow.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 README.md docs/DESIGN.md docs/API.md -t "$pkgdir/usr/share/doc/$pkgname"
}
