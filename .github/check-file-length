#!/bin/bash
# Fails when a source file changed since BASE is over the line cap, grew, and doesn't say why: `.github/check-file-length [BASE]`.
# BASE defaults to HEAD, so with no argument it checks what isn't committed yet; CI passes the pull request's base.
# Files are split before they grow past the cap: a long file that got longer, or a new one over it, fails; a move or a
# cut of a long file passes. One that is a single cohesive unit (a parser, an exhaustive router), generated, or a table
# of data says so with `modular-exempt: <reason>` in its first 10 lines.
set -euo pipefail
cd "$(dirname "$0")/.."
base=${1:-HEAD}
cap=300
failed=0
lines_at_base() { git show "$base:$1" 2>/dev/null | wc -l || echo 0; }
while IFS=$'\t' read -r status old new; do
  file=${new:-$old}
  case "$file" in
    *.rs | *.sh | *.py | *.ts | *.js | *.luau | *.lua | *.java | *.c | *.h | *.html | *.css) ;;
    *) continue ;;
  esac
  [ -f "$file" ] || continue
  lines=$(wc -l <"$file")
  [ "$lines" -gt "$cap" ] || continue
  case "$status" in A) before=0 ;; *) before=$(lines_at_base "$old") ;; esac
  [ "$lines" -gt "$before" ] || continue
  head -n 10 "$file" | grep -q 'modular-exempt:' && continue
  if [ "$before" -eq 0 ]; then was="new"; else was="up from $before"; fi
  echo "$file: $lines lines ($was), over the cap of $cap. Split it, or say why not with \"modular-exempt: <reason>\" in its first 10 lines." >&2
  failed=1
done < <(git diff --name-status --diff-filter=AMR "$base" -- . && git ls-files --others --exclude-standard | sed 's/^/A\t/')
exit $failed
